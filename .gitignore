node_modules/
dist/
*.tsbuildinfo
coverage/
.DS_Store
*.log

# Bugpatrol local data. Everything else in .bugpatrol/ (the config, the app
# guide, and the gate's manifests) is committed.
#
# A pattern containing a slash is anchored to this file's directory, so a bare
# `.bugpatrol/runs/` misses `examples/*/.bugpatrol/runs/`. The `**/` prefix
# applies it at every depth.
**/.bugpatrol/runs/

# The fixture workspace that the review-smoke-dashboard and review-smoke-cli setups write.
/.review-smoke/

# The fixture app is a test subject, not a project: its baselines are captured
# fresh by scripts/determinism-check.sh and are tied to one machine's rendering.
examples/fixture-app/.bugpatrol/*
!examples/fixture-app/.bugpatrol/bugpatrol.yml

.env
.env.*
!.env.example
test-results/
playwright-report/

# Copied from packages/dashboard/src/ui by the bugpatrol bundle build.
packages/bugpatrol/src/ui/

# Copied from the repo root by the bugpatrol bundle build.
packages/bugpatrol/LICENSE
packages/bugpatrol/NOTICE
