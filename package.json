{
  "name": "bugpatrol-monorepo",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "packageManager": "pnpm@12.19.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc --build",
    "clean": "tsc --build --clean",
    "typecheck": "tsc --build --force",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "knip": "knip --no-config-hints",
    "gate": "biome check . --error-on-warnings && knip --no-config-hints && tsc --build",
    "gate:changed": "git diff --name-only --diff-filter=d origin/main -- \"*.ts\" \"*.tsx\" \"*.js\" \"*.mjs\" \"*.json\" | xargs -r biome check --no-errors-on-unmatched --error-on-warnings && tsc --build && vitest run --changed origin/main --passWithNoTests",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@types/node": "^22.7.5",
    "husky": "^9.1.7",
    "knip": "^6.38.0",
    "lint-staged": "^17.6.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.3"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,json}": "biome check --write --no-errors-on-unmatched"
  }
}
